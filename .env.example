# These public Supabase client values are embedded in the frontend build.
# Use only the project's anon or publishable key here, never a service-role key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
# Or use VITE_SUPABASE_PUBLISHABLE_KEY instead of VITE_SUPABASE_ANON_KEY.
# Razorpay credentials are configured only as Supabase Edge Function secrets.

# Keep cloud accounts, account creation, and all payment flows disabled until privacy,
# child-safety, legal, and payment-provider requirements are reviewed and operational.
VITE_CLOUD_ACCOUNTS_ENABLED=false
VITE_ACCOUNT_CREATION_ENABLED=false
VITE_PAYMENTS_ENABLED=false
